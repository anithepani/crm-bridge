# Fastn credentials for the serverless API (api/). Copy to .env for local work.
# On Vercel, set these as Project Environment Variables instead.

# Fastn API key, scoped to the embed customer. Never expose in the browser.
FASTN_API_KEY=

# The Fastn customer (end-org) UUID the widget is scoped to.
FASTN_END_ORG_ID=ac8316f8-4f08-4206-8884-27c63cf451af

# Optional: your workspace org id, only needed for a customer-pinned key.
FASTN_ORG_ID=

# Optional: the org that owns the sync workflows (where executions land).
# Defaults to this demo's workspace org.
FASTN_WORKSPACE_ORG_ID=personal_3c15292b6ae5e0d20385

# Optional: Fastn API host (default https://api.fastn.dev)
FASTN_HOST=

# Optional: comma-separated CORS allowlist.
# Defaults to https://anithepani.github.io,http://localhost:3000
ALLOWED_ORIGINS=
